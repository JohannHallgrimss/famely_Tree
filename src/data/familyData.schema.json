{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family Data",
  "type": "object",
  "required": [
    "patriot",
    "persons"
  ],
  "properties": {
    "patriot": {
      "type": "string"
    },
    "familyStories": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "persons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "born",
          "father",
          "mother",
          "spouse",
          "gender",
          "address",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "born": {
            "type": "string"
          },
          "father": {
            "type": [
              "string",
              "null"
            ]
          },
          "mother": {
            "type": [
              "string",
              "null"
            ]
          },
          "spouse": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}