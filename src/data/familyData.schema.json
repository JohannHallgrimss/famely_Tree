{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family Data",
  "type": "object",
  "required": ["patriot", "persons"],
  "properties": {
    "patriot": {
      "type": "string"
    },
    "persons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "born", "father", "mother", "gender", "address", "phone"],
        "properties": {
          "name": {
            "type": "string"
          },
          "born": {
            "type": "string"
          },
          "father": {
            "type": ["string", "null"]
          },
          "mother": {
            "type": ["string", "null"]
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female"]
          },
          "address": {
            "type": ["string", "null"]
          },
          "phone": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
